{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode-ai/omnia",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol/index.ts",
    "./protocol/*": "./src/protocol/*.ts",
    "./enterprise": "./src/enterprise/index.ts",
    "./*": "./src/*.ts"
  },
  "bin": {
    "omnia-server": "./src/server/cli.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "test:computer-use": "bun test src/computer-use/live-harness/ src/computer-use/",
    "test:input-freeze": "bun test src/server/input-freeze.test.ts",
    "standalone": "bun ./src/server/standalone.ts",
    "enterprise": "bun ./src/server/cli.ts",
    "build:server": "bun build ./src/server/cli.ts --compile --outfile ./dist/omnia-server",
    "license": "bun ./script/license.ts"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:"
  },
  "dependencies": {}
}
