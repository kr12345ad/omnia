{
  "name": "@omnisciens-technologies/omnia",
  "private": true,
  "version": "26.10.0",
  "type": "module",
  "license": "UNLICENSED",
  "homepage": "https://opencode.ai",
  "author": {
    "name": "OpenCode",
    "email": "hello@opencode.ai"
  },
  "scripts": {
    "typecheck": "tsgo -b",
    "predev": "bun ./scripts/predev.ts",
    "dev": "electron-vite dev",
    "prebuild": "bun ./scripts/prebuild.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder --config electron-builder.config.ts",
    "package:mac": "bun run build:mac && bun script/verify-target.ts && electron-builder --mac --config electron-builder.config.ts",
    "package:win": "bun run build:win && bun script/verify-target.ts && electron-builder --win --config electron-builder.config.ts",
    "package:linux": "bun run build && bun script/verify-target.ts && electron-builder --linux --config electron-builder.config.ts",
    "native:build": "bun install --cwd native",
    "legal:smoke": "bun script/legal.ts smoke",
    "build:mac": "OMNIA_TARGET_PLATFORM=darwin OMNIA_TARGET_ARCH=x64 sh -c 'bun ./scripts/prebuild.ts && electron-vite build'",
    "build:win": "OMNIA_TARGET_PLATFORM=win32 OMNIA_TARGET_ARCH=x64 sh -c 'bun ./scripts/prebuild.ts && electron-vite build'"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "@opencode-ai/omnia": "workspace:*",
    "@zip.js/zip.js": "2.7.62",
    "effect": "catalog:",
    "electron-context-menu": "4.1.2",
    "electron-log": "^5",
    "electron-store": "11.0.2",
    "electron-updater": "6.8.11",
    "electron-window-state": "^5.0.3",
    "drizzle-orm": "catalog:",
    "@huggingface/transformers": "3.8.1"
  },
  "devDependencies": {
    "@actions/artifact": "6.3.1",
    "@lydell/node-pty": "catalog:",
    "@opencode-ai/app": "workspace:*",
    "@opencode-ai/ui": "workspace:*",
    "@sentry/solid": "catalog:",
    "@sentry/vite-plugin": "catalog:",
    "@solid-primitives/i18n": "2.2.1",
    "@solid-primitives/storage": "catalog:",
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "0.15.4",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@valibot/to-json-schema": "1.6.0",
    "electron": "42.11.16",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0-beta.5",
    "pdfjs-dist": "6.4.299",
    "solid-js": "catalog:",
    "sury": "11.0.0-alpha.4",
    "typescript": "~5.6.2",
    "vite": "catalog:",
    "zod-openapi": "5.4.6"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.12",
    "@parcel/watcher-darwin-arm64": "2.5.1",
    "@parcel/watcher-darwin-x64": "2.5.1",
    "@parcel/watcher-linux-arm64-glibc": "2.5.1",
    "@parcel/watcher-linux-arm64-musl": "2.5.1",
    "@parcel/watcher-linux-x64-glibc": "2.5.1",
    "@parcel/watcher-linux-x64-musl": "2.5.1",
    "@parcel/watcher-win32-arm64": "2.5.1",
    "@parcel/watcher-win32-x64": "2.5.1"
  }
